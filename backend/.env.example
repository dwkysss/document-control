# Server Configuration
PORT=5001
NODE_ENV=production

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://appuser:appsecurepassword@postgres:5432/doccontroldb
AUTH_SECRET=replace-with-a-random-64-character-secret-before-deploying

# Uploads directory
UPLOAD_DIR=./public/uploads

# Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3001,http://127.0.0.1:3005

# Automated Google Drive Per-File Encrypted Backup
GDRIVE_BACKUP_ENABLED=true
GDRIVE_FOLDER_ID=your_target_google_drive_folder_id
GDRIVE_SERVICE_ACCOUNT_KEY=./credentials/gdrive-service-account.json
BACKUP_ENCRYPTION_KEY=replace-with-a-random-32-character-encryption-passphrase
