# ==============================================================================
# VPS Production Environment Configuration (.env)
# Standard: ISO 9001:2015 Clause 7.5 Document Control (Self-Hosted PostgreSQL)
# ==============================================================================

# 1. Host Port Mapping (Loopback 127.0.0.1 - Zero port collision)
APP_PORT=3005
BACKEND_PORT=5005

# 2. PostgreSQL 16 Database (Internal Docker network only, NOT exposed to host/internet)
DB_USER=doccontrol_user
DB_PASSWORD=ChangeThisSecurePassword123!
DB_NAME=doccontrol_db

# 3. Domain & Public Access
DOMAIN=doccontrol.yourdomain.com
ALLOWED_ORIGINS=https://doccontrol.yourdomain.com,http://localhost:3000,http://127.0.0.1:3005
