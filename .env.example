# ==============================================================================
# VPS Production Environment Configuration (.env)
# Standard: ISO 9001:2015 Clause 7.5 Document Control (Self-Hosted PostgreSQL)
# ==============================================================================

# 1. Host Port Mapping (Loopback 127.0.0.1 - Zero port collision)
APP_PORT=3005
BACKEND_PORT=5005

# 2. PostgreSQL 16 Database (Internal Docker network only, NOT exposed to host/internet)
DB_USER=doccontrol_user
DB_PASSWORD=ChangeThisSecurePassword123!
DB_NAME=doccontrol_db
AUTH_SECRET=replace-with-a-random-64-character-secret-before-deploying

# 3. Domain & Public Access
DOMAIN=dc.dentellejayainfinitex.io
ALLOWED_ORIGINS=https://dc.dentellejayainfinitex.io,http://localhost:3000,http://127.0.0.1:3005

# 4. Automated Google Drive Per-File Encrypted Backup (ISO 9001 Clause 7.5.3)
GDRIVE_BACKUP_ENABLED=true
GDRIVE_FOLDER_ID=your_target_google_drive_folder_id
GDRIVE_SERVICE_ACCOUNT_KEY=./credentials/gdrive-service-account.json
BACKUP_ENCRYPTION_KEY=replace-with-a-random-32-character-encryption-passphrase
